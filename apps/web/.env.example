# Salin ke .env.local untuk pengembangan lokal. JANGAN isi nilai produksi di berkas ini.
# Nilai Supabase lokal: jalankan `supabase status -o env` di akar repo.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:15421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server saja; jangan pernah diawali NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Kata sandi Auth siswa diturunkan dari PIN dengan kunci ini (Fase 36), minimal 16 karakter.
# Nilai lokal ini harus sama dengan student_pin_pepper di packages/content/seed/families.json agar
# siswa seed bisa masuk. Produksi WAJIB memakai nilai acak lain; menggantinya membatalkan semua PIN.
STUDENT_PIN_PEPPER=coreta-lokal-pepper-pin-siswa

# Tampilkan tombol masuk dengan Google (butuh [auth.external.google] di supabase/config.toml).
AUTH_GOOGLE_ENABLED=false
