{
  "name": "@coreta/scoring",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "test": "vitest run --config ../../vitest.workspace.ts packages/scoring/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "coverage": "vitest run --config ../../vitest.workspace.ts packages/scoring/ --coverage --coverage.provider=v8 --coverage.include=packages/scoring/src/**/*.ts --coverage.exclude=**/*.test.ts --coverage.thresholds.lines=90"
  }
}
