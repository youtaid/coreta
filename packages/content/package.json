{
  "name": "@coreta/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.workspace.ts packages/content/",
    "coverage": "vitest run --config ../../vitest.workspace.ts packages/content/ --coverage --coverage.provider=v8 --coverage.include=packages/content/src/**/*.ts --coverage.exclude=**/*.test.ts --coverage.exclude=**/fixtures.ts --coverage.thresholds.lines=90"
  },
  "dependencies": {
    "@coreta/scoring": "workspace:*",
    "zod": "4.6.5"
  }
}
