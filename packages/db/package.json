{
  "name": "@coreta/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.workspace.ts packages/db/",
    "check:rls": "vitest run --config ../../vitest.workspace.ts packages/db/src/migrations-rls.test.ts",
    "gen:types": "supabase gen types typescript --local --schema public > src/types.ts && prettier --write src/types.ts"
  },
  "devDependencies": {
    "@types/node": "20.19.43"
  }
}
