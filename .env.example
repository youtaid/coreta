# Salin ke apps/web/.env.local (Next.js) dan apps/worker/.env (worker), lalu isi nilainya.
# Nilai lokal: jalankan `supabase status -o env` setelah `supabase start`
# (API_URL -> NEXT_PUBLIC_SUPABASE_URL, ANON_KEY -> NEXT_PUBLIC_SUPABASE_ANON_KEY,
#  SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:15421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server dan worker saja; jangan pernah diberi awalan NEXT_PUBLIC_

AI_PROVIDER=                      # google | openai | anthropic
AI_MODEL_HINT=
AI_MODEL_HANDWRITING=
AI_MODEL_REPORT=
AI_MODEL_SUPPORT=
AI_API_KEY_GOOGLE=
AI_API_KEY_OPENAI=
AI_API_KEY_ANTHROPIC=
AI_COST_CAP_PER_STUDENT_IDR=8000

PAYMENT_PROVIDER=                 # mock | orderhero | midtrans
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
